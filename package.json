{
  "name": "pulse",
  "version": "1.0.0",
  "description": "PULSE — Endeavour Mining Group IT project tracking & alignment platform",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/api/**/*.test.js\"",
    "a11y": "node scripts/a11y_drill.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "connect-pg-simple": "10.0.0",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "helmet": "8.0.0",
    "node-cron": "4.2.1",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "playwright-core": "^1.49.1",
    "supertest": "7.0.0"
  }
}
