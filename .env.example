# PULSE environment — copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection (app -> db). In docker-compose this is assembled for you;
# only POSTGRES_PASSWORD is needed there.
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
POSTGRES_PASSWORD=change-this-db-password

# Session signing secret — long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-this-to-a-long-random-string

# App port
PORT=3000

# Set true when serving behind TLS (marks the session cookie Secure)
SECURE_COOKIES=false

# Where the daily pg_dump lands (docker-compose mounts the `backups` volume here)
BACKUP_DIR=/backups

# Tests only: dedicated test database
DATABASE_URL_TEST=postgres://pulse:pulse@localhost:5432/pulse_test
